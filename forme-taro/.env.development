# 本地开发环境 —— npm run dev:weapp 时自动加载
# 只注入 TARO_APP_ 前缀的变量，其余变量不会进小程序代码包。

# 后端地址。
# 本地联调用 http 是可以的，但必须在微信开发者工具里勾选
#   详情 → 本地设置 → 不校验合法域名、web-view（业务域名）、TLS 版本以及 HTTPS 证书
# （本工程的 project.config.json 已经把 urlCheck 设为 false，默认就是勾上的）
TARO_APP_API_BASE=http://127.0.0.1:8787

# 0 = 真实请求后端（需要先启动 forme-server）
# 1 = 不请求后端，生成返回本地演示图、余额固定 128、充值本地模拟
#
# 只想看 UI 不想起后端时改成 1。
TARO_APP_USE_MOCK=0

# 图片 CDN。留空 = 用原型里的 Unsplash 地址
TARO_APP_MEDIA_BASE=

# 品牌字体 CDN。留空 = 回落系统字体
TARO_APP_FONT_BASE=
