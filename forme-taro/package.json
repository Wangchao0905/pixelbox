{
  "name": "forme-taro",
  "version": "1.0.0",
  "private": true,
  "description": "Pixel Box 微信小程序 — 由 visual-studio 移动端原型迁移",
  "templateInfo": {
    "name": "react",
    "typescript": true,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit",
    "check:request-key": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-request-key.mjs",
    "check:no-pixel": "node scripts/check-no-pixel-in-ui.mjs",
    "check:prompt-mirror": "node scripts/check-prompt-mirror.mjs",
    "check:asset-filters": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-asset-filters.mjs",
    "check:poster-directions": "node scripts/check-poster-directions.mjs",
    "test:creator-ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-creator-ui.mjs",
    "test:reference-images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-reference-images.mjs",
    "test:reference-recreate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-reference-recreate.mjs",
    "test:product-studio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-product-studio.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "measure:page": "node scripts/measure-page.mjs",
    "release": "npm run typecheck && npm run check:request-key && npm run check:no-pixel && npm run check:prompt-mirror && npm run check:asset-filters && npm run test:creator-ui && npm run test:reference-images && npm run test:reference-recreate && npm run test:product-studio && npm run build:weapp && npm run verify:dist && npm run check:poster-directions",
    "preview:weapp": "node scripts/upload-weapp.mjs preview",
    "upload:weapp": "node scripts/upload-weapp.mjs upload"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-platform-h5": "^4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.2.1",
    "postcss": "^8.4.38",
    "react-refresh": "^0.14.0",
    "sass": "^1.77.0",
    "typescript": "^5.4.5",
    "webpack": "5.91.0",
    "miniprogram-ci": "^2.0.5"
  },
  "optionalDependencies": {
    "@swc/core-linux-x64-gnu": "1.3.96",
    "@tarojs/binding-linux-x64-gnu": "4.2.1",
    "@tarojs/plugin-doctor-linux-x64-gnu": "0.0.13"
  }
}
