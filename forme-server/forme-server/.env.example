# Pixel Box 服务端环境变量
# 复制成 .env.local 后填真实值；.env.local 已在 .gitignore 里，不会提交。
# 优先级：真实环境变量 > .env.local > .env

# ---------------------------------------------------------------
# 运行
# ---------------------------------------------------------------
PORT=8787

# 监听地址。本地开发保持 0.0.0.0（局域网真机调试要能连上）。
# 生产必须改成 127.0.0.1，只让本机 nginx 连进来 ——
# 绑 0.0.0.0 时限流可被伪造 X-Forwarded-For 绕过，服务会拒绝启动。
HOST=0.0.0.0

# 仅 Docker 内网方案需要设 1（详见 deploy/docker-compose.yml）
# ALLOW_PUBLIC_BIND=1

# 数据目录（state.json 与上传文件都放这里）。生产环境请挂持久卷。
DATA_DIR=data

# 开发开关：没有真实微信凭据 / 图片模型 key 时，把它们打开就能跑通全流程。
# 上线前必须全部改成 0 —— NODE_ENV=production 时留 1 会直接拒绝启动。
MOCK_WECHAT=1
MOCK_LLM=1

# 内容安全审核：off 不检查 / log 只记录 / enforce 拦截
# 生产必须 enforce，否则服务拒绝启动（审核过不了 + 违规内容会下架）
SECURITY_MODE=log

# 每张图消耗的点数。改价只改这里，客户端会自动跟随 /api/catalog 的返回值，
# 不需要重新发版。必须是正数：0 等于白送，NaN 会把余额算成 NaN。
# 当前定价：1 点 = ¥1，单张图 0.4 点（¥0.4/张）。
IMAGE_COST=0.4

# 新用户初始点数。默认 0 —— **不送点数**，用户必须充值才能出图。
# 想搞拉新活动再调大，注意每 0.4 点 = 白送一张图。
# 本地调试若想直接点通出图流程，可以临时设成一个正数。
INITIAL_BALANCE=0

# ---------------------------------------------------------------
# AIGC 内容标识（《人工智能生成合成内容标识办法》，2025-09-01 施行）
# ---------------------------------------------------------------
# 出图落盘时把「生成合成内容属性 + 服务提供者名称 + 内容编号」写进文件元数据
# （PNG 写 iTXt 块、JPEG 写 COM 段）。生产环境关掉会拒绝启动 ——
# 第五条是硬要求，不是可选项。详见 DEPLOY.md 第 13 节。
AIGC_METADATA=1
# 隐式标识里的服务提供者名称。为空会拒绝启动：三要素缺一项。
AIGC_PROVIDER=Pixel Box
# 显式标识文案，随 /api/catalog 下发。客户端不写死这几个字，
# 这样改文案能覆盖已装在用户手机上的旧版本。
AIGC_EXPLICIT_LABEL=AI 生成

# ---------------------------------------------------------------
# 接口限流（每分钟）
# ---------------------------------------------------------------
# 关掉它意味着任何人都能循环调 /api/generate-image 把模型额度刷爆。
# 生产环境关掉会拒绝启动。
RATE_LIMIT_ENABLED=1
RATE_LIMIT_GENERATE_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_ORDER_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# ---------------------------------------------------------------
# 告警
# ---------------------------------------------------------------
# 留空则只写日志。生产建议配上：退款缺口这类真实亏损只写日志等于没写。
# 支持企业微信 / 钉钉 / 飞书机器人，或任意接收 JSON POST 的地址。
ALERT_WEBHOOK_URL=
# generic | wecom | dingtalk | feishu
ALERT_WEBHOOK_FORMAT=generic

# ---------------------------------------------------------------
# 临时 1 元真实支付验收（默认关闭，验收后删除 MP 道具并移除这三项）
# ---------------------------------------------------------------
TEST_PAYMENT_ENABLED=0
TEST_PAYMENT_PRODUCT_ID=forme_test
# 只填测试账号的 OpenID，多个值用逗号分隔；留空时不能开启
TEST_PAYMENT_OPENIDS=

# ---------------------------------------------------------------
# 微信小程序（服务端专用，绝不能进小程序代码包）
# ---------------------------------------------------------------
WECHAT_APPID=wxf595b8865bcbf254
# code2Session 用，小程序后台 → 开发管理 → 开发设置 → AppSecret
WECHAT_APP_SECRET=your_app_secret
# 虚拟支付：MP 后台 → 虚拟支付 → 基本配置
WECHAT_OFFER_ID=your_offer_id
WECHAT_APP_KEY=your_current_app_key
# 固定 0（正式环境/现网）
WECHAT_ENV=0
# 发货推送回调地址，必须是公网 HTTPS。
# 注意路径是 /api/pay/notify，漏掉 /api 平台会一直收到 404 并重试。
WECHAT_PAY_NOTIFY_URL=https://your-api-domain.example/api/pay/notify
# MP 后台【开发管理 → 消息推送】里自己填的 Token，两边必须一致。
# 后台点「保存」时微信会发一个验证请求到上面的地址，服务端用它验签后
# 原样返回 echostr；对不上后台就报「配置失败」，配置存不下去。
WECHAT_MSG_TOKEN=your_message_push_token

# ---------------------------------------------------------------
# 图片模型（复用 visual-studio 原型用的上游）
# ---------------------------------------------------------------
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://llm-api.net
# 上游超时（毫秒）。必须设：出图可能挂住几分钟，
# 没有超时的话预扣的点数会一直被占住。
LLM_TIMEOUT_MS=180000

# ---------------------------------------------------------------
# 退出行为
# ---------------------------------------------------------------
# 收到 SIGTERM 后最多等多久在飞请求（毫秒），到点就落盘退出。
#
# 出图最长可以跑到 LLM_TIMEOUT_MS（180 秒），默认只等 5 秒，所以发布时
# 在飞的出图请求基本都会被砍掉 —— 这是有意的取舍。
# 被砍掉的请求留下的「孤儿预扣」会在下次启动时自动退还给用户，不会资损。
#
# 想改成「排空再退出」就调大这个值，但必须同时调大 systemd 的
# TimeoutStopSec（默认 15 秒），否则 systemd 会先 SIGKILL，等于没配。
SHUTDOWN_GRACE_MS=5000
