# FORMÉ 服务端 · 生产配置（只差 6 个必填配置）
# ==================================================================
# 这份文件已经把**所有非密钥项**都填好了，包括域名。
# 你只需要填下面标了 【待填】 的 6 行：微信 4 项 + 图片模型 2 项。
#
# 用法（在服务器上）：
#   cp deploy/.env.local.ready .env.local
#   vim .env.local                 # 填 6 个必填配置
#   chmod 600 .env.local           # 里面全是密钥，别让同机器其他用户读到
#   NODE_ENV=production npm run preflight
#
# 本文件里没有任何真实密钥（待填项是空的），所以可以安全地留在仓库里。
# 填好之后的 .env.local 已在 .gitignore 里，不会被提交。
#
# 优先级：真实环境变量 > .env.local > .env
# ⚠️ 每一项改动都要重启服务才生效。
# ==================================================================

# ---------------------------------------------------------------
# 运行
# ---------------------------------------------------------------
PORT=8787

# 裸机部署必须绑回环：只让本机 nginx 连进来。
# 绑 0.0.0.0 会让限流可被 X-Forwarded-For 伪造绕过（服务会拒绝启动）。
HOST=127.0.0.1

# 数据目录。state.json 与用户上传都在这里 —— **必须挂持久卷**，
# 否则重启即丢全部用户、点数与订单。
DATA_DIR=data

# ---------------------------------------------------------------
# 上线开关
# ---------------------------------------------------------------

# 必须解析成 production，否则下面这些拦截一条都不会触发：
# MOCK_WECHAT=1 会让任何人构造一个 code 就登录任意账号；
# SECURITY_MODE=log 会让违规内容不被拦（小程序被下架）；限流也会被绕过。
# systemd 单元里也有一份 Environment=NODE_ENV=production，两处都留着更稳：
# 少配一处，拦截就静默失效，而且**不会报错**。
NODE_ENV=production

MOCK_WECHAT=0
MOCK_LLM=0

# off / log / enforce。生产必须 enforce。
SECURITY_MODE=enforce

# ---------------------------------------------------------------
# 计费
# ---------------------------------------------------------------
# 1 点 = ¥1，单张图 0.4 点（¥0.4/张）。改价只改这里，客户端自动跟随。
IMAGE_COST=0.4
# 注册送 1 点（约可免费出 2 张图）。调大等于给每个新账号多送产品。
INITIAL_BALANCE=1

# ---------------------------------------------------------------
# AIGC 内容标识（《人工智能生成合成内容标识办法》，2025-09-01 施行）
# ---------------------------------------------------------------
# 第五条是硬要求：关掉会拒绝启动。
AIGC_METADATA=1
# 隐式标识里的服务提供者名称。为空会拒绝启动。
AIGC_PROVIDER=FORMÉ
AIGC_EXPLICIT_LABEL=AI 生成

# ---------------------------------------------------------------
# 接口限流（每分钟）
# ---------------------------------------------------------------
RATE_LIMIT_ENABLED=1
RATE_LIMIT_GENERATE_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_ORDER_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# ---------------------------------------------------------------
# 微信小程序（服务端专用，绝不能进小程序代码包）
# ---------------------------------------------------------------
WECHAT_APPID=wxf595b8865bcbf254

# 【待填】小程序后台 → 开发管理 → 开发设置 → AppSecret
WECHAT_APP_SECRET=

# 【待填】MP 后台 → 虚拟支付 → 基本配置 → OfferID
WECHAT_OFFER_ID=

# 【待填】MP 后台 → 虚拟支付 → 基本配置 → **现网** AppKey
#   注意：不是旧版支付的 key，也不是调试用的 key。
WECHAT_APP_KEY=

# 固定 0（正式环境/现网）
WECHAT_ENV=0

# 发货推送回调地址。**已按真实域名填好。**
# 配好后必须去【开发与服务 → 开发管理 → 消息推送】把同一个地址填上
# —— 那个设置**不在「虚拟支付」那一栏里**。
# 路径不能少 /api：漏了平台会一直收到 404 并无限重试，用户付了钱永远不到账。
WECHAT_PAY_NOTIFY_URL=https://pixeltoy.cn/api/pay/notify

# 【待填】上面那个「消息推送」页面里自己填的 Token，两边必须逐字一致。
#   点「保存」时微信会发一个验证请求到上面的地址，服务端用这个 Token 验签后
#   原样返回 echostr；对不上后台就报「配置失败」，配置根本存不下去。
#   自己定一个字符串即可，不含空格、不加引号 —— 它会原样参与 sha1 计算。
WECHAT_MSG_TOKEN=

# ---------------------------------------------------------------
# 图片模型上游
# ---------------------------------------------------------------
# 【待填】上游 key
LLM_API_KEY=
# 【待填】上游地址，不带结尾斜杠。会请求 {baseUrl}/v1/images/generations 与 /edits
LLM_BASE_URL=

# 上游超时（毫秒）。出图可能挂住几分钟，没有超时的话预扣的点数会一直被占住。
LLM_TIMEOUT_MS=180000

# ---------------------------------------------------------------
# 退出行为
# ---------------------------------------------------------------
# 收到 SIGTERM 后最多等多久在飞请求（毫秒），到点就落盘退出。
#
# 出图最长可以跑到 LLM_TIMEOUT_MS，默认只等 5 秒，所以**每次发布都会砍掉
# 在飞的出图请求** —— 这是有意的取舍，等满 180 秒才能发布不可接受。
# 被砍掉的请求会留下「孤儿预扣」，由下次启动自动退还给用户，不会资损。
#
# 调大这个值可以改成「排空再退出」，但必须同时调大
# deploy/forme-server.service 里的 TimeoutStopSec（默认 15 秒），
# 否则 systemd 会先 SIGKILL，这个值等于没生效。
SHUTDOWN_GRACE_MS=5000

# ---------------------------------------------------------------
# 告警（强烈建议配，不是必须）
# ---------------------------------------------------------------
# 退款缺口、孤儿预扣这类真实资金事件只写日志等于没写 —— 没人会去翻服务器日志。
# 支持企业微信 / 钉钉 / 飞书机器人，或任意接收 JSON POST 的地址。
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=generic
