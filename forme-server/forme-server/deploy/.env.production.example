# Pixel Box 服务端 · 生产环境变量模板
# ==================================================================
# 用法：复制到服务器上的 forme-server/.env.local，然后填真实值。
#   cp deploy/.env.production.example .env.local
#   chmod 600 .env.local        # 里面全是密钥，别让同机器其他用户读到
#
# .env.local 已在 .gitignore 里，不会被提交。
# 优先级：真实环境变量 > .env.local > .env
#
# ⚠️ 每一项改动都要重新启动服务才生效。
# ==================================================================

# ---------------------------------------------------------------
# 运行
# ---------------------------------------------------------------
PORT=8787

# 裸机部署必须绑回环：只让本机 nginx 连进来。
# 绑 0.0.0.0 会让限流可被 X-Forwarded-For 伪造绕过（服务会拒绝启动）。
HOST=127.0.0.1

# 数据目录。state.json 与用户上传都在这里 —— **必须挂持久卷**，
# 否则重启即丢全部用户、点数与订单。
DATA_DIR=data

# 仅 Docker 内网方案需要设为 1（详见 deploy/docker-compose.yml）。
# 裸机部署保持注释掉。
# ALLOW_PUBLIC_BIND=1

# ---------------------------------------------------------------
# 上线开关 —— 这几项配错会直接拒绝启动
# ---------------------------------------------------------------

# 运行环境。**必须解析成 production**，否则下面这些拦截一条都不会触发：
# MOCK_WECHAT=1 会让任何人构造一个 code 就登录任意账号；
# SECURITY_MODE=log 会让违规内容不被拦（小程序被下架）；限流也会被绕过。
#
# 写在这里是生效的（取值链：真实环境变量 > .env.local > .env）。
# systemd 单元里也有一份 Environment=NODE_ENV=production，两处都留着更稳：
# 少配一处，拦截就静默失效，而且**不会报错**。
NODE_ENV=production

MOCK_WECHAT=0
MOCK_LLM=0

# off / log / enforce
# 生产必须 enforce：不做内容审核，小程序审核过不了，
# 且一旦出现违规内容有下架风险。
SECURITY_MODE=enforce

# 每张图消耗的点数。改价只改这里即可 ——
# 客户端一律以 /api/catalog 返回的 imageCost 为准，不需要重新发版。
# 必须是正数：填 0 会导致出图完全免费，填非法值会把余额算成 NaN 且无法恢复，
# 两种情况生产环境都会拒绝启动。
# 当前定价：1 点 = ¥1，单张图 0.4 点（¥0.4/张）。
# 是小数，所以余额与流水都按两位小数记账，不要改成整数分。
IMAGE_COST=0.4

# 新用户初始点数。
# **默认 0：不赠送点数**，新用户余额为 0。
# 只有做拉新活动时才调大，注意每 0.4 点就等于白送一张图。
INITIAL_BALANCE=0

# ---------------------------------------------------------------
# AIGC 内容标识（《人工智能生成合成内容标识办法》2025-09-01 施行）
# ---------------------------------------------------------------
# 出图落盘时写入文件元数据（PNG → iTXt，JPEG → COM），承载
# 「生成合成内容属性 + 服务提供者名称 + 内容编号」三要素。
# ⚠️ 生产环境设为 0 会**拒绝启动**：第五条是硬要求。
AIGC_METADATA=1
# 服务提供者名称。为空会拒绝启动。支持中文（内部用 UTF-8 的 iTXt，不会乱码）。
AIGC_PROVIDER=Pixel Box
# 显式标识文案，随 /api/catalog 下发，客户端不写死。
AIGC_EXPLICIT_LABEL=AI 生成

# ---------------------------------------------------------------
# 接口限流（单位：每分钟）
# ---------------------------------------------------------------
RATE_LIMIT_ENABLED=1
RATE_LIMIT_GENERATE_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_ORDER_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# ---------------------------------------------------------------
# 微信小程序（服务端专用，绝不能进小程序代码包）
# ---------------------------------------------------------------
WECHAT_APPID=wxf595b8865bcbf254

# 小程序后台 → 开发管理 → 开发设置 → AppSecret
# ⚠️ 这个值只在生成时显示一次，丢了只能重置
WECHAT_APP_SECRET=

# ---------------------------------------------------------------
# 微信虚拟支付（个人主体 · 道具直购）
# 小程序后台 → 虚拟支付 → 基本配置
# ---------------------------------------------------------------
WECHAT_OFFER_ID=
# 现网 AppKey（不是沙箱的）
WECHAT_APP_KEY=
# 0 = 正式环境。个人主体固定 0
WECHAT_ENV=0

# 发货 / 退款推送回调地址。必须是**公网 HTTPS**。
# ⚠️ 路径必须是 /api/pay/notify —— 漏掉 /api 平台会一直收到 404 并无限重试。
# 配好后务必用 deploy/verify-notify.sh 验证一次可达性。
WECHAT_PAY_NOTIFY_URL=https://你的域名/api/pay/notify

# MP 后台【开发与服务 → 开发管理 → 消息推送】里自己填的 Token，两边必须逐字一致。
# 后台点「保存」时微信会发一个验证请求（GET 带 echostr）到上面的地址，
# 服务端用它验签后原样返回 echostr；对不上后台就报「配置失败」，配置存不下去。
# 不含空格、不加引号 —— 它会原样参与 sha1 计算，多一个字符就对不上。
WECHAT_MSG_TOKEN=

# ---------------------------------------------------------------
# 图片生成上游（OpenAI Images 兼容接口）
# ---------------------------------------------------------------
LLM_API_KEY=
# 上游地址，不带结尾斜杠。会请求 {baseUrl}/v1/images/generations 与 /edits
LLM_BASE_URL=https://你的上游地址
# 上游超时（毫秒）。必须设：没有超时的话，上游挂住会一直占着用户预扣的点数
LLM_TIMEOUT_MS=180000

# ---------------------------------------------------------------
# 退出行为
# ---------------------------------------------------------------
# 收到 SIGTERM 后最多等多久在飞请求（毫秒），到点就落盘退出。
#
# 出图最长可以跑到 LLM_TIMEOUT_MS，默认只等 5 秒，所以**每次发布都会砍掉
# 在飞的出图请求** —— 这是有意的取舍，等满 180 秒才能发布不可接受。
# 被砍掉的请求会留下「孤儿预扣」，由下次启动自动退还给用户，不会资损。
#
# 调大这个值可以改成「排空再退出」，但必须同时调大
# deploy/forme-server.service 里的 TimeoutStopSec（默认 15 秒），
# 否则 systemd 会先 SIGKILL，这个值等于没生效。
SHUTDOWN_GRACE_MS=5000

# ---------------------------------------------------------------
# 告警（强烈建议配）
# ---------------------------------------------------------------
# 退款缺口这类真实亏损只写日志等于没写 —— 没人会去翻服务器日志。
# 支持企业微信 / 钉钉 / 飞书机器人，或任意接收 JSON POST 的地址。
ALERT_WEBHOOK_URL=
# generic | wecom | dingtalk | feishu
ALERT_WEBHOOK_FORMAT=wecom
